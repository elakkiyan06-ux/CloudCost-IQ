# CloudCost IQ Environment Configuration
# Copy this file to .env and configure values for your environment

# Server Runtime Settings
PORT=8000
ENVIRONMENT=production

# Persistence Paths
SQLITE_DB_PATH=/app/data/cloudcost.db
PRICING_DATA_PATH=/app/data/pricing.json

# CORS Allowed Origins (Comma-separated or * for wildcard)
CORS_ORIGINS=*

# Deployment & CI/CD Placeholders (Configured in GitHub Repository Secrets)
# DEPLOY_HOST=your-ec2-public-ip-or-domain.com
# DEPLOY_USER=ubuntu
# DEPLOY_SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----\n...
